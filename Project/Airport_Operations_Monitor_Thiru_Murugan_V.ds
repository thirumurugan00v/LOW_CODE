			conditional formatting
			(
				"New Formatting1"
				{
				condition = (airport_status == "Congested")
				fields = [airport_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (airport_status == "Operational")
				fields = [airport_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
