	reports
	{
		list Flight_Disruption_Report
		{
			displayName = "All Flight Disruptions"
			show all rows from Flight_Disruption    
			(
				flight_number as "Flight Number"
				airport_code as "Airport Code"
				disruption_type as "Disruption Type"
				severity as "Severity"
				disruption_start_time as "Disruption Start Time"
				disruption_end_time as "Disruption End Time"
				estimated_delay_minutes as "Estimated Delay Minutes"
				affected_passengers as "Affected Passengers"
				disruption_status as "Disruption Status"
				assigned_team as "Assigned Team"
				root_cause as "Root Cause"
				resolution_notes as "Resolution Notes"
				linked_flight as "Linked Flight"
				linked_airport as "Linked Airport"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (severity == "High")
				fields = [severity]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (severity == "Low")
				fields = [severity]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (severity == "Medium")
				fields = [severity]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban Flight_Disruption_by_disruption_type
		{
			displayName = "Disruption Types"
			show all rows from Flight_Disruption    
			(
				flight_number as "Flight Number"
				airport_code as "Airport Code"
				disruption_type as "Disruption Type"
				severity as "Severity"
				disruption_start_time as "Disruption Start Time"
				disruption_end_time as "Disruption End Time"
				estimated_delay_minutes as "Estimated Delay Minutes"
				affected_passengers as "Affected Passengers"
				disruption_status as "Disruption Status"
				assigned_team as "Assigned Team"
				root_cause as "Root Cause"
				resolution_notes as "Resolution Notes"
				linked_flight as "Linked Flight"
				linked_airport as "Linked Airport"
			)
			options
			(
	 			display field = disruption_type
	 		)
		}
		list Airport_Details_Report
		{
			displayName = "All Airport Details"
			show all rows from Airport_Details    
			(
				airport_name as "Airport Name"
				airport_code as "Airport Code"
				city as "City"
				state as "State"
				country1 as "Country"
				terminal_count as "Terminal Count"
				airport_status as "Airport Status"
				airport_capacity_per_day as "Airport Capacity Per Day"
