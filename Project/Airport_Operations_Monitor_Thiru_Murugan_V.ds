 application "Airport Operations Monitor"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form Airport_Details
		{
			displayname = "Airport Details"
			success message = "Airport Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			airport_name
			(
    			type = text
				displayname = "Airport Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			airport_code
			(
    			type = text
				displayname = "Airport Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			city
			(
    			type = text
				displayname = "City"
	 			row = 1
	 			column = 1   
				width = medium
			)
			state
			(
    			type = text
				displayname = "State"
	 			row = 1
	 			column = 1   
				width = medium
			)
			country1
			(
    			type = text
				displayname = "Country"
	 			row = 1
	 			column = 1   
				width = medium
			)
			terminal_count
			(
				type = number
				displayname = "Terminal Count"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			airport_status
			(
				type = picklist
				displayname = "Airport Status"
				values = {"Congested","Partially Closed","Operational","Closed"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			airport_capacity_per_day
			(
				type = number
				displayname = "Airport Capacity Per Day"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Flight_Disruption
		{
			displayname = "Flight Disruption"
			success message = "Flight Disruption Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			flight_number
			(
    			type = text
				displayname = "Flight Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			airport_code
			(
    			type = text
				displayname = "Airport Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			disruption_type
			(
				type = picklist
				displayname = "Disruption Type"
				values = {"Weather","Security Issue","Baggage Issue","Gate Change","Staffing Issue","Technical Issue","Flight Cancellation","Flight Delay","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			severity
			(
				type = picklist
				displayname = "Severity"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			disruption_start_time
			(
    			type = datetime
				displayname = "Disruption Start Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			disruption_end_time
			(
    			type = datetime
				displayname = "Disruption End Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_delay_minutes
			(
				type = number
				displayname = "Estimated Delay Minutes"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			affected_passengers
			(
				type = number
				displayname = "Affected Passengers"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			disruption_status
			(
				type = picklist
				displayname = "Disruption Status"
				values = {"Reported","Investigating","In Progress","Resolved"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_team
			(
    			type = text
				displayname = "Assigned Team"
	 			row = 1
	 			column = 1   
				width = medium
			)
			root_cause
			(
    			type = textarea
				displayname = "Root Cause"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolution_notes
			(
    			type = textarea
				displayname = "Resolution Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			linked_flight
			(
				type = picklist	
				displayname = "Linked Flight"
				values  = Flight_Management.ID
    			displayformat = [flight_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			linked_airport
			(
				type = picklist	
				displayname = "Linked Airport"
				values  = Airport_Details.ID
    			displayformat = [airport_code]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Disruption Reported","Initial Assessment","Severity Classification","Investigation Phase","Root Cause Analysis","Resolution Planning","Action Execution","Monitoring Phase","Resolution Verification","Disruption Resolved","Post-Resolution Review","Process Closed"}
			}
		}
