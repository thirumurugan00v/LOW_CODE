		workflow
		{
		form
		{
			auto_set_airport_status as "Auto-Set Airport Status"
			{
				type =  form
				form = Flight_Management

				record event = on add or edit

				on user input of passenger_count
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the airport record linked to the current flight
										linkedAirport = input.linked_airport;
										// Check if the linked airport exists and get its details
										if(!linkedAirport.isNull())
										{
											airportRecord = Airport_Details[ID == linkedAirport];
											// Check if airport record was found
											if(!airportRecord.isNull())
											{
												// Get current passenger count and airport capacity
												currentPassengerCount = input.passenger_count;
												airportCapacity = airportRecord.airport_capacity_per_day;
												// Check if capacity is exceeded
												if(currentPassengerCount > airportCapacity)
												{
													// Update the airport status to Congested
													airportRecord.airport_status="Congested";
													// Log the update
													info "Airport status updated to Congested due to capacity exceeded. Current passengers: " + currentPassengerCount.toString() + ", Capacity: " + airportCapacity.toString();
												}
												else
												{
													// Log that capacity is not exceeded
													info "Airport capacity not exceeded. Current passengers: " + currentPassengerCount.toString() + ", Capacity: " + airportCapacity.toString();
												}
											}
											else
											{
												// Log if airport record not found
												info "Airport record not found for ID: " + linkedAirport.toString();
											}
										}
										else
										{
											// Log if no linked airport
											info "No linked airport found for this flight.";
										}
						)
					}
				}

			}
			delay_notification_alert as "Delay Notification Alert"
			{
				type =  form
				form = Flight_Management

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if flight status is Delayed
										if(input.flight_status == "Delayed")
										{
											// Get the flight number and delay duration
											flightNumber = input.flight_number;
											delayDuration = input.delay_duration_minutes;
											// Construct notification message
											notificationMessage = "Flight " + flightNumber + " is delayed by " + delayDuration.toString() + " minutes. Please take necessary action.";
											// Send push notification to operations team
											zoho.pushNotification(zoho.loginuserid,"Flight Delay Alert",notificationMessage,"",input.ID);
										}
						)
					}
				}

			}
			critical_disruption_email as "Critical Disruption Email"
			{
				type =  form
				form = Flight_Disruption

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Check if severity is Critical
										if(input.severity == "Critical")
										{
											// Get the disruption details
											disruptionType = input.disruption_type;
											flightNumber = input.flight_number;
											airportCode = input.airport_code;
											estimatedDelay = input.estimated_delay_minutes;
											affectedPassengers = input.affected_passengers;
											// Construct email message
											subject = "CRITICAL: Flight Disruption Alert - " + flightNumber;
											message = "<p>Dear Email Management Team,</p>";
											message = message.concat("<p>A critical flight disruption has been reported:</p>");
											message = message.concat("<ul>");
											message = message.concat("<li><strong>Flight Number:</strong> " + flightNumber + "</li>");
											message = message.concat("<li><strong>Airport Code:</strong> " + airportCode + "</li>");
											message = message.concat("<li><strong>Disruption Type:</strong> " + disruptionType + "</li>");
											message = message.concat("<li><strong>Estimated Delay:</strong> " + estimatedDelay + " minutes</li>");
											message = message.concat("<li><strong>Affected Passengers:</strong> " + affectedPassengers + "</li>");
											message = message.concat("</ul>");
											message = message.concat("<p>Please take immediate action.</p>");
											// Send email to management team
											sendmail
											[
												from :zoho.loginuserid
												to :"emailmanagement@zoho.com"
												subject :subject
												message :message
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_congestion_report as "Daily Congestion Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all congested airports from Airport_Details form
										congestedAirports = Airport_Details[airport_status == "Congested"];
										// Check if there are any congested airports
										if(congestedAirports.count() > 0)
										{
											// Build the summary message
											summaryMessage = "<h2>Daily Congested Airport Summary</h2>";
											summaryMessage = summaryMessage.concat("<p>The following airports are currently congested:</p>");
											// Iterate through each congested airport
											for each  airport in congestedAirports
											{
												summaryMessage = summaryMessage.concat("<ul>");
												summaryMessage = summaryMessage.concat("<li><strong>");
												summaryMessage = summaryMessage.concat(airport.airport_name);
												summaryMessage = summaryMessage.concat("</strong> (Code: ");
												summaryMessage = summaryMessage.concat(airport.airport_code);
												summaryMessage = summaryMessage.concat(")</li>");
												// Add remarks if available
												if(!airport.remarks.isEmpty())
												{
													summaryMessage = summaryMessage.concat("<li>Remarks: ");
													summaryMessage = summaryMessage.concat(airport.remarks);
													summaryMessage = summaryMessage.concat("</li>");
												}
												// Add capacity information if available
												if(!airport.airport_capacity_per_day.isNull())
												{
													summaryMessage = summaryMessage.concat("<li>Capacity: ");
													summaryMessage = summaryMessage.concat(airport.airport_capacity_per_day.toString());
													summaryMessage = summaryMessage.concat(" flights/day</li>");
												}
												summaryMessage = summaryMessage.concat("</ul>");
											}
											// Send email to stakeholders
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.adminuserid
												subject :"Daily Summary: Congested Airports"
												message :summaryMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


