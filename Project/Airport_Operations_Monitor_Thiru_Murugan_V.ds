			{
				name = "Flight Dispatcher"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Update flight status details including actual arrival and departure times \n"
				ModulePermissions
				{
					Flight_Disruption
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
